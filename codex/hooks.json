{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"./codex/session_check.py\"",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "python \"./codex/env_guard.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'You just edited an HA config file. If a Home Assistant skill is active, follow its next-step instructions. Otherwise, mention $ha-deploy is available for validation and deployment.' 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
